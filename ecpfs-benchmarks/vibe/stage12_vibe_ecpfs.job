#!/bin/bash
#SBATCH --job-name=vibe_ecp
#SBATCH --output=vibe_ecp_%a.out
#SBATCH --error=vibe_ecp_%a.err
#SBATCH --array=0-3%1
#SBATCH --nodes=1
#SBATCH --cpus-per-task=16
#SBATCH --mem=150G
#SBATCH --time=24:00:00
#SBATCH --partition=cores

# STAGE 12: eCP-FS run through VIBE's own run.py (--local), same protocol as the Faiss IVF and hnswlib jobs:
# all 1000 test queries, k = 100, each setting run 5 times and the best run reported, one core, one thread.
# Array task 0=ccnews, 1=imagenet-clip, 2=laion-clip, 3=msmarco. msmarco uses algorithm "ecpfs-msmarco" (512 KB and up).
# Cluster sizes and per-query budgets are the same as in the stand-alone eCP-FS run (budget 3/12/50/200/800 MB per query).
# Start it AFTER the Faiss jobs (never at the same time):
#   sbatch --nodelist=cn8 --dependency=afterany:<HNSW job id> stage12_vibe_ecpfs.job
# Results: ~/vibe_run_ecp_<name>/results/<dataset>/100/<ecpfs or ecpfs-msmarco>/*.hdf5
set -eo pipefail
export TMPDIR=$HOME/tmp TMP_DIR=$HOME/tmp TMP=$HOME/tmp TEMP=$HOME/tmp
mkdir -p "$TMPDIR"

NAMES=(ccnews-nomic-768-normalized imagenet-clip-512-normalized laion-clip-512-normalized msmarco-qwen-1024-normalized)
NAME=${NAMES[$SLURM_ARRAY_TASK_ID]}
SHORT=${NAME%%-*}
DATA=$HOME/vibe_data/$NAME.hdf5
SRC=$HOME/vibe_src
WORK=$HOME/vibe_run_ecp_$SHORT
SCR=/scratch/${SLURM_JOB_ID}
if [ "$SHORT" = "msmarco" ]; then ALGO=ecpfs-msmarco; NEED=100; else ALGO=ecpfs; NEED=30; fi

echo "=== CONTEXT: $NAME ($ALGO) ==="; hostname; date; nproc; lscpu | grep "Model name"; free -g | head -2
echo "load average: $(cat /proc/loadavg)"
test -f "$DATA" || { echo "STOP: $DATA not found"; exit 1; }
test -f "$SRC/vibe/algorithms/ecpfs/module.py" || { echo "STOP: run stage12_install_ecp_in_vibe.job first"; exit 1; }
avail_gb=$(df -BG --output=avail /scratch | tail -1 | tr -dc '0-9')
[ "${avail_gb:-0}" -ge "$NEED" ] || { echo "STOP: less than $NEED GB free in /scratch"; exit 1; }

module load Miniconda3/25.5.1-1
source /opt/itu/easybuild/software/Miniconda3/25.5.1-1/etc/profile.d/conda.sh
conda activate "$HOME/ecp_env"
# VIBE's worker starts "python3" from PATH, so the activated environment must be the first python3
echo "python3 = $(which python3)"
python3 -c "import ecpfs, numba; print('ecpfs + numba OK')"
echo "VIBE commit: $(git -C "$SRC" rev-parse HEAD)"
echo "eCP-FS commit: $(git -C "$HOME/ecp_src" rev-parse HEAD 2>/dev/null || echo unknown)"

cleanup() { rm -rf "$SCR"; echo "scratch cleaned"; }
trap cleanup EXIT INT TERM
mkdir -p "$SCR"
export ECPFS_WORKDIR=$SCR            # index files go on the fast local disk, as in the stand-alone run

rm -rf "$WORK"; mkdir -p "$WORK/data"
cp -r "$SRC/vibe" "$SRC/run.py" "$SRC/run_algorithm.py" "$SRC/logging.conf" "$WORK/"
ln -s "$DATA" "$WORK/data/$NAME.hdf5"
cd "$WORK"

echo; echo "=================== $ALGO ==================="; date
python3 run.py --dataset "$NAME" --local --module ecpfs --algorithm "$ALGO" --count 100 --runs 5 --parallelism 1 --timeout 86400 \
  || echo "FAILED $ALGO on $NAME (continuing)"

echo; echo "=== SUMMARY ==="; date
echo "$ALGO: $(ls "results/$NAME/100/$ALGO" 2>/dev/null | grep -c '\.hdf5$') result files"
du -sh results 2>/dev/null
echo "ALL DONE"
