index 0000000..79653ea
--- /dev/null
+++ b/vibe/algorithms/ecpfs/module.py
@@ -0,0 +1,87 @@
+import atexit
+import os
+import shutil
+import tempfile
+
+import h5py
+import numpy as np
+from ecpfs import Builder, Index, Metric
+
+from ..base.module import BaseANN
+
+
+class EcpFs(BaseANN):
+    """eCP-FS (file-based cluster index) as a VIBE algorithm.
+
+    cluster_kb is the target size C of one leaf cluster on disk. The number of vectors per cluster follows the
+    paper's formula: target_items = C / V with V = dimensions * 4 bytes (float32). The tree has 2 levels for under
+    5M vectors and 3 for more (the same rule as the stand-alone eCP-FS run). The index files live in
+    $ECPFS_WORKDIR (fast local disk), default the system temp dir, and are deleted when the process ends.
+    """
+
+    def __init__(self, metric, dimension, cluster_kb):
+        self.metric = metric
+        self.dimension = int(dimension)
+        self.cluster_kb = int(cluster_kb)
+        self.search_exp = 1
+        self.index = None
+        self.workdir = None
+
+    def fit(self, X):
+        if self.metric in ("normalized", "ip"):
+            metric, is_norm = Metric.IP, self.metric == "normalized"
+        elif self.metric == "euclidean":
+            metric, is_norm = Metric.L2, False
+        else:
+            raise ValueError("unsupported metric for EcpFs: " + str(self.metric))
+
+        n, d = X.shape
+        self.levels = 2 if n < 5_000_000 else 3
+        self.target_items = max(2, round(self.cluster_kb * 1024 / (4 * d)))
+
+        base = os.environ.get("ECPFS_WORKDIR") or tempfile.gettempdir()
+        self.workdir = tempfile.mkdtemp(prefix="ecpfs_", dir=base)
+        atexit.register(shutil.rmtree, self.workdir, True)
+        emb = os.path.join(self.workdir, "emb.h5")
+        index_path = os.path.join(self.workdir, "index.zarr")
+
+        with h5py.File(emb, "w") as g:
+            dset = g.create_dataset("embeddings", shape=(n, d), dtype="float32", chunks=(min(n, 10_000), d))
+            step = 100_000
+            for s in range(0, n, step):
+                dset[s : s + step] = np.asarray(X[s : s + step], dtype=np.float32)
+
+        b = Builder(
+            index_path=index_path,
+            levels=self.levels,
+            metric=metric,
+            is_normalized=is_norm,
+            embedding_dtype=None,
+            node_chunk_bytes=512 * 1024,
+        )
+        b.select_representatives(
+            embeddings_file=emb, target_cluster_items=self.target_items, strategy="offset", fallback_batch_rows=100_000
+        )
+        b.build(embeddings_file=emb, fallback_batch_rows=100_000)
+        os.remove(emb)
+
+        self.index_path = index_path
+        self.index_bytes = sum(
+            os.path.getsize(os.path.join(r, f)) for r, _, fs in os.walk(index_path) for f in fs
+        )
+        self.index = Index(index_path)
+
+    def set_query_arguments(self, search_exp):
+        self.search_exp = int(search_exp)
+
+    def query(self, v, n):
+        q = np.asarray(v, dtype=np.float32)
+        items, qid = self.index.new_search(query=q, k=n, search_exp=self.search_exp, max_increments=-1, exclude_vec=[])
+        self.index.end_search(qid)
+        return [int(i) for _s, i in items][:n]
+
+    def get_additional(self):
+        return {"index_bytes_on_disk": int(self.index_bytes), "levels": self.levels, "target_items": self.target_items}
+
+    def __str__(self):
+        return "EcpFs(cluster_kb=%d, levels=%d, search_exp=%d)" % (self.cluster_kb, self.levels, self.search_exp)
